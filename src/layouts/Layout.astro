---
import { profile } from '../data/profile';
import ProfileChat from '../components/ProfileChat.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; home?: boolean }
const { title = 'Tomas Ferrer — Full Stack Data Scientist', description = profile.description, home = false } = Astro.props;
const nav = [['about', 'About me'], ['experience', 'Experience'], ...(profile.education.length ? [['education', 'Education']] : []), ['work', 'Selected work'], ['skills', 'Skills'], ['contact', 'Contact']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/tomas-ferrer.png', Astro.site)} />
    <meta name="theme-color" content="#172a2a" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="sidebar">
      <div class="identity-group">
      <a class="identity" href="/" aria-label="Tomas Ferrer home">
        <img src="/tomas-ferrer.png" width="800" height="800" alt="Tomas Ferrer" />
        <span class="identity-copy"><strong>Tomas Ferrer<span class="accent">.</span></strong><span>Full Stack Data Scientist</span></span>
      </a>
      <div class="sidebar-socials" role="group" aria-label="Social profiles">
        <a href={profile.linkedin} aria-label="LinkedIn (opens in a new tab)" title="LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.8-1.52 2.99 0 3.57 1.97 3.57 4.53v5.24Z" /></svg></a>
        <a href={profile.github} aria-label="GitHub (opens in a new tab)" title="GitHub" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15A10.8 10.8 0 0 1 12 6.16c.96 0 1.92.13 2.82.38 2.15-1.46 3.09-1.15 3.09-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg></a>
        <a href={profile.x} aria-label="X (opens in a new tab)" title="X" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-7.42L5.57 22H2.44l7.17-8.2L1.2 2h6.4l4.42 6.76L18.9 2Zm-1.1 18h1.73L6.66 3.89H4.8L17.8 20Z" /></svg></a>
      </div>
      </div>
      <div class="sidebar-rule"></div>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Explore <span aria-hidden="true">＋</span></button>
      <nav id="navigation" aria-label="Main navigation">
        {nav.map(([id, label], index) => <a href={`${home ? '' : '/'}#${id}`} data-section={id} class:list={{ active: home && index === 0 }} aria-current={home && index === 0 ? 'location' : undefined}><span class="nav-number">0{index + 1}</span>{label}<span class="nav-arrow" aria-hidden="true">↗</span></a>)}
      </nav>
      <div class="sidebar-bottom"><a href="https://tomasferrer.com">tomasferrer.com <span aria-hidden="true">↗</span></a>{profile.cv && <a href={profile.cv} download>Download CV ↓</a>}</div>
    </aside>
    <main id="main" tabindex="-1"><slot /><footer><span>© {new Date().getFullYear()} Tomas Ferrer</span><span>Made with care & Astro.</span><a href="#main">Back to top ↑</a></footer></main>
    <ProfileChat />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); navigation?.classList.remove('is-open'); }
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); navigation?.classList.toggle('is-open', open); });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeMenu(); toggle?.focus(); } });
      const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
      if (sections.length) {
        const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]')];
        const update = () => {
          const threshold = window.innerWidth <= 800 ? 180 : 200;
          let current = sections[0].id;
          for (const section of sections) if (section.getBoundingClientRect().top <= threshold) current = section.id;
          if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8) current = sections[sections.length - 1].id;
          links.forEach(link => { const active = link.dataset.section === current; link.classList.toggle('active', active); if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
        };
        let queued = false;
        window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { update(); queued = false; }); } }, { passive: true });
        window.addEventListener('resize', update); update();
      }
    </script>
  </body>
</html>
