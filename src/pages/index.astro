---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---
<Layout home>
  <section id="about" class="intro">
    <div class="intro-top"><span class="eyebrow"><span class="tiny-dot"></span> DATA SCIENCE · ANALYTICS</span></div>
    <h1 class="intro-greeting">Hi, I'm <span class="serif">Tom</span></h1>
    <div class="intro-copy"><p>I’m a product data scientist based in the New York Metro area. I care about asking the right questions, making assumptions explicit, and understanding what the evidence can actually support.</p><p>Good analysis should make a decision clearer. Sometimes that means a sophisticated model. Sometimes it means a better question.</p></div>
    <a class="text-link" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
    <div class="intro-foot"><span>A little about what I do.<br />And what makes me curious.</span><a href="#experience" aria-label="Continue to experience">↓</a></div>
  </section>
  <section id="experience" class="content-section">
    <div class="section-heading"><span class="eyebrow">01 / THE JOURNEY</span><h2>Experience<span class="accent-dark">.</span></h2></div>
    <div class="experience-actions"><p>Data science, analytics, and product decisions across fintech, marketplaces, and operations.</p><a class="text-link" href={profile.cv} download>Download CV <span aria-hidden="true">↓</span></a></div>
    <div class="timeline">{profile.experience.map(item => <article class="timeline-row"><div class="dates">{item.dates}</div><div class="career-card"><div class="career-brand"><div class="company-logo"><img src={item.logo} alt="" width="52" height="52" loading="lazy" /></div><div class="career-brand-copy"><div class="career-heading"><h3>{item.company}</h3><span class="career-location">{item.location}</span></div>{item.context && <p class="career-context">{item.context}</p>}<p class="company">{item.role}</p></div></div><ul>{item.highlights.map(text => <li>{text}</li>)}</ul></div></article>)}</div>
  </section>
  <section id="education" class="content-section"><div class="section-heading"><span class="eyebrow">02 / THE FOUNDATIONS</span><h2>Education<span class="accent-dark">.</span></h2></div><div class="timeline">{profile.education.map(item => <article class="timeline-row"><span class="dates">{item.dates}</span><div class="career-card"><div class="career-brand education-brand"><div class="company-logo"><img src={item.logo} alt="" width="52" height="52" loading="lazy" /></div><div class="career-brand-copy"><h3>{item.institution}</h3><p class="company">{item.degree}</p><p class="education-detail">{item.detail}</p></div></div></div></article>)}</div></section>
  <section id="work" class="content-section">
    <div class="section-heading"><span class="eyebrow">03 / IDEAS INTO PRACTICE</span><h2>Selected work<span class="accent-dark">.</span></h2><p>A place for things I build, questions I explore, and what I learn along the way.</p></div>
    <a class="project-card article-card" href="https://medium.com/mynd-technology/advanced-forecasting-using-ml-to-build-multi-state-probability-distributions-be14ff481c3" target="_blank" rel="noopener noreferrer">
      <div class="project-art article-art" aria-hidden="true"><div class="art-grid"></div><span class="art-caption">MYND TECHNOLOGY / MEDIUM</span><div class="forecast-cover"><span class="forecast-symbol">P(s, t)</span><span class="forecast-idea">One property.<br />Many possible futures.</span></div><div class="art-bottom"><span>MODELING UNCERTAINTY</span><span>2022</span></div></div>
      <div class="project-info"><div class="project-kicker"><span>WRITING / MACHINE LEARNING</span><time datetime="2022-07-01">JUL 1, 2022</time></div><h3>Advanced Forecasting <span aria-hidden="true">↗</span></h3><p class="article-subtitle">Using ML to build multi-state probability distributions.</p><p>Forecasting rental activity at Mynd by modeling each property’s possible future states, then aggregating those probabilities into a portfolio forecast.</p><div class="tags"><span>Forecasting</span><span>Machine learning</span><span>Probability</span></div><span class="project-read">Read on Medium · 7 min <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></div>
    </a>
    <a class="project-card" href="/projects/personal-website/">
      <div class="project-art" aria-hidden="true"><div class="art-grid"></div><span class="art-caption">A SPACE OF MY OWN</span><div class="art-word">tf<span>.</span></div><div class="art-bottom"><span>IDEAS. WORK. CURIOSITY.</span><span>001</span></div></div>
      <div class="project-info"><div class="project-kicker"><span>WEB / PERSONAL PROJECT</span><span>2026</span></div><h3>A home on the internet <span aria-hidden="true">↗</span></h3><p>Building tomasferrer.com: a simple, considered place for my work and the person behind it.</p><div class="tags"><span>Astro</span><span>Design</span><span>Web development</span></div><span class="project-read">Read the project story <span aria-hidden="true">→</span></span></div>
    </a>
    <p class="work-note"><span aria-hidden="true">↳</span> More questions to explore. More work to share.</p>
  </section>
  <section id="skills" class="content-section">
    <div class="section-heading"><span class="eyebrow">04 / THE TOOLKIT</span><h2>Skills<span class="accent-dark">.</span></h2></div>
    <div class="skills-grid">{profile.skills.map(group => <div class="skill-group"><h3>{group.category}</h3><ul>{group.items.map(skill => <li>{skill}</li>)}</ul></div>)}</div>
  </section>
  <section id="contact" class="content-section contact"><span class="eyebrow">05 / KEEP IN TOUCH</span><h2>Good conversations<br />start with <span class="serif">hello.</span></h2>{profile.email ? <a class="contact-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a> : <p>Public contact details are coming soon.</p>}<div class="contact-socials">{profile.linkedin && <a href={profile.linkedin}>LinkedIn ↗</a>}{profile.github && <a href={profile.github}>GitHub ↗</a>}</div></section>
</Layout>
