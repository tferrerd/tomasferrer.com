# Build-time public backend URL; leave unset to keep the chat launcher hidden.
PUBLIC_AGENT_URL=http://127.0.0.1:8080
# Backend only. Never use PUBLIC_ for the API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://127.0.0.1:4321,http://127.0.0.1:4322
DAILY_REQUEST_LIMIT=200
